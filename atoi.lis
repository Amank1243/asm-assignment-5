    26                                  ;
    27                                  ; Program's Purpose:
    28                                  ; This file converts a null-terminated ASCII string into
    29                                  ; a signed 64-bit integer. The atoi function processes
    30                                  ; individual ASCII digits, converts them into numeric values,
    31                                  ; and constructs the integer using multiplication and addition.
    32                                  ; The function also supports positive and negative signs.
    33                                  ; The converted integer is returned in the rax register.
    34                                  ;
    35                                  ; Project Information:
    36                                  ; Files: main.asm, kernel.asm, atoi.asm, itoa.asm, r.sh
    37                                  ; Developing Computer: Windows 11, Ubuntu via WSL
    38                                  ; Status: Completed and tested
    39                                  ;
    40                                  ; Translator Information:
    41                                  ; Assembler: NASM, elf64
    42                                  ; Linker: GNU ld
    43                                  ; Operating System: Ubuntu via WSL
    44                                  
    45                                  
    46                                  global atoi
    47                                  
    48                                  section .text
    49                                  
    50                                  atoi:
    51 00000000 4831C0                      xor rax, rax        ; Initialize result to 0
    52 00000003 4831C9                      xor rcx, rcx        ; Character index
    53 00000006 4D31C0                      xor r8, r8          ; Negative number flag
    54                                  
    55                                      ; Check for a negative sign
    56 00000009 803F2D                      cmp byte [rdi], '-'
    57 0000000C 750B                        jne check_positive
    58                                  
    59 0000000E 41B801000000                mov r8, 1
    60 00000014 48FFC1                      inc rcx
    61 00000017 EB08                        jmp convert_loop
    62                                  
    63                                  check_positive:
    64 00000019 803F2B                      cmp byte [rdi], '+'
    65 0000001C 7503                        jne convert_loop
    66                                  
    67 0000001E 48FFC1                      inc rcx
    68                                  
    69                                  convert_loop:
    70 00000021 480FB6140F                  movzx rdx, byte [rdi + rcx]
    71                                  
    72                                      ; Stop at null terminator or non-digit
    73 00000026 80FA30                      cmp dl, '0'
    74 00000029 7215                        jb conversion_done
    75                                  
    76 0000002B 80FA39                      cmp dl, '9'
    77 0000002E 7710                        ja conversion_done
    78                                  
    79                                      ; Convert ASCII character into digit
    80 00000030 4883EA30                    sub rdx, '0'
    81                                  
    82                                      ; result = result * 10 + digit
    83 00000034 486BC00A                    imul rax, rax, 10
    84 00000038 4801D0                      add rax, rdx
    85                                  
    86 0000003B 48FFC1                      inc rcx
    87 0000003E EBE1                        jmp convert_loop
    88                                  
    89                                  conversion_done:
    90                                      ; Apply negative sign if necessary
    91 00000040 4983F801                    cmp r8, 1
    92 00000044 7503                        jne atoi_done
    93                                  
    94 00000046 48F7D8                      neg rax
    95                                  
    96                                  atoi_done:
    97 00000049 C3                          ret
