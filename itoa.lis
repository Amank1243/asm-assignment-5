    26                                  ;
    27                                  ; Program's Purpose:
    28                                  ; This file converts a signed 64-bit integer into a
    29                                  ; null-terminated ASCII string. The itoa function repeatedly
    30                                  ; divides the integer by 10 to extract its decimal digits.
    31                                  ; The digits are converted into ASCII characters and stored
    32                                  ; in reverse order within an output buffer. The function
    33                                  ; also handles zero and negative integers and returns the
    34                                  ; address of the resulting string in the rax register.
    35                                  ;
    36                                  ; Project Information:
    37                                  ; Files: main.asm, kernel.asm, atoi.asm, itoa.asm, r.sh
    38                                  ; Developing Computer: Windows 11, Ubuntu via WSL
    39                                  ; Status: Completed and tested
    40                                  ;
    41                                  ; Translator Information:
    42                                  ; Assembler: NASM, elf64
    43                                  ; Linker: GNU ld
    44                                  ; Operating System: Ubuntu via WSL
    45                                  
    46                                  
    47                                  global itoa
    48                                  
    49                                  section .text
    50                                  
    51                                  itoa:
    52                                      ; Preserve registers
    53 00000000 53                          push rbx
    54 00000001 4154                        push r12
    55                                  
    56                                      ; Copy integer into rax
    57 00000003 4889F8                      mov rax, rdi
    58                                  
    59                                      ; Point to the end of the output buffer
    60 00000006 4889F3                      mov rbx, rsi
    61 00000009 4883C314                    add rbx, 20
    62                                  
    63                                      ; Null terminate the string
    64 0000000D C60300                      mov byte [rbx], 0
    65                                  
    66                                      ; Initialize negative flag
    67 00000010 41BC00000000                mov r12, 0
    68                                  
    69                                      ; Check if number is negative
    70 00000016 4883F800                    cmp rax, 0
    71 0000001A 7D09                        jge conversion_start
    72                                  
    73                                      ; Remember negative sign
    74 0000001C 41BC01000000                mov r12, 1
    75                                  
    76                                      ; Convert to unsigned magnitude
    77 00000022 48F7D8                      neg rax
    78                                  
    79                                  conversion_start:
    80                                      ; Set divisor to 10
    81 00000025 B90A000000                  mov rcx, 10
    82                                  
    83                                  convert_digit:
    84                                      ; Clear upper portion of dividend
    85 0000002A BA00000000                  mov rdx, 0
    86                                  
    87                                      ; Divide by 10
    88                                      ; Quotient goes into rax
    89                                      ; Remainder goes into rdx
    90 0000002F 48F7F1                      div rcx
    91                                  
    92                                      ; Convert remainder into ASCII
    93 00000032 80C230                      add dl, '0'
    94                                  
    95                                      ; Move backward through buffer
    96 00000035 48FFCB                      dec rbx
    97                                  
    98                                      ; Store digit
    99 00000038 8813                        mov byte [rbx], dl
   100                                  
   101                                      ; Repeat until quotient is zero
   102 0000003A 4883F800                    cmp rax, 0
   103 0000003E 75EA                        jne convert_digit
   104                                  
   105                                      ; Check whether a minus sign is needed
   106 00000040 4983FC01                    cmp r12, 1
   107 00000044 7506                        jne conversion_done
   108                                  
   109                                      ; Add negative sign
   110 00000046 48FFCB                      dec rbx
   111 00000049 C6032D                      mov byte [rbx], '-'
   112                                  
   113                                  conversion_done:
   114                                      ; Return address of ASCII string
   115 0000004C 4889D8                      mov rax, rbx
   116                                  
   117                                      ; Restore registers
   118 0000004F 415C                        pop r12
   119 00000051 5B                          pop rbx
   120                                  
   121 00000052 C3                          ret
