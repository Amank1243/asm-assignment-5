    26                                  ;
    27                                  ; Program's Purpose:
    28                                  ; This program demonstrates the use of Linux kernel system calls
    29                                  ; for input and output in x86-64 assembly. The program prompts
    30                                  ; the user for their full name and two integers, multiplies the
    31                                  ; integers, and displays their product. It also displays a
    32                                  ; personalized greeting and farewell message.
    33                                  ;
    34                                  ; Project Information:
    35                                  ; Files: main.asm, kernel.asm, atoi.asm, itoa.asm, r.sh
    36                                  ; Developing Computer: Windows 11, Ubuntu via WSL
    37                                  ; Status: Completed and tested
    38                                  ;
    39                                  ; Translator Information:
    40                                  ; Assembler: NASM, elf64
    41                                  ; Linker: GNU ld
    42                                  ; Operating System: Ubuntu via WSL
    43                                  
    44                                  extern printString
    45                                  extern readString
    46                                  extern atoi
    47                                  extern itoa
    48                                  
    49                                  global _start
    50                                  
    51                                  section .data
    52                                  
    53                                      ; Constants
    54                                      sys_exit     equ 60
    55                                      exit_success equ 0
    56                                      line_feed    equ 10
    57                                      null         equ 0
    58                                  
    59                                      ; Messages
    60 00000000 506C6561736520656E-         name_prompt db "Please enter your full name: ", null
    60 00000009 74657220796F757220-
    60 00000012 66756C6C206E616D65-
    60 0000001B 3A2000             
    61 0000001E 5468616E6B20796F75-         thank_message db "Thank you ", null
    61 00000027 2000               
    62                                  
    63 00000029 506C6561736520656E-         first_prompt db "Please enter the first integer: ", null
    63 00000032 746572207468652066-
    63 0000003B 6972737420696E7465-
    63 00000044 6765723A2000       
    64 0000004A 506C6561736520656E-         second_prompt db "Please enter the second integer: ", null
    64 00000053 746572207468652073-
    64 0000005C 65636F6E6420696E74-
    64 00000065 656765723A2000     
    65                                  
    66 0000006C 5468652070726F6475-         product_message db "The product of these two integers is ", null
    66 00000075 6374206F6620746865-
    66 0000007E 73652074776F20696E-
    66 00000087 746567657273206973-
    66 00000090 2000               
    67 00000092 486176652061206E69-         farewell_message db "Have a nice career ", null
    67 0000009B 636520636172656572-
    67 000000A4 2000               
    68                                  
    69 000000A6 0A00                        new_line db line_feed, null
    70 000000A8 0A0A00                      double_new_line db line_feed, line_feed, null
    71                                  
    72                                  section .bss
    73                                  
    74                                      ; Input buffers
    75 00000000 <res 64h>                   name_buffer resb 100
    76 00000064 <res 32h>                   first_buffer resb 50
    77 00000096 <res 32h>                   second_buffer resb 50
    78                                  
    79                                      ; Output buffer
    80 000000C8 <res 15h>                   product_buffer resb 21
    81                                  
    82                                      ; Integer storage
    83 000000DD ????????????????            first_number resq 1
    84 000000E5 ????????????????            second_number resq 1
    85 000000ED ????????????????            product resq 1
    86                                  
    87                                  section .text
    88                                  
    89                                  _start:
    90                                  
    91                                      ; Ask for the user's full name
    92 00000000 48BF-                       mov rdi, name_prompt
    92 00000002 [0000000000000000] 
    93 0000000A E8(00000000)                call printString
    94                                  
    95 0000000F 48BF-                       mov rdi, name_buffer
    95 00000011 [0000000000000000] 
    96 00000019 BE64000000                  mov rsi, 100
    97 0000001E E8(00000000)                call readString
    98                                  
    99                                      ; Print two newlines
   100 00000023 48BF-                       mov rdi, double_new_line
   100 00000025 [A800000000000000] 
   101 0000002D E8(00000000)                call printString
   102                                  
   103                                      ; Thank the user
   104 00000032 48BF-                       mov rdi, thank_message
   104 00000034 [1E00000000000000] 
   105 0000003C E8(00000000)                call printString
   106                                  
   107 00000041 48BF-                       mov rdi, name_buffer
   107 00000043 [0000000000000000] 
   108 0000004B E8(00000000)                call printString
   109                                  
   110 00000050 48BF-                       mov rdi, double_new_line
   110 00000052 [A800000000000000] 
   111 0000005A E8(00000000)                call printString
   112                                  
   113                                      ; Read the first integer
   114 0000005F 48BF-                       mov rdi, first_prompt
   114 00000061 [2900000000000000] 
   115 00000069 E8(00000000)                call printString
   116                                  
   117 0000006E 48BF-                       mov rdi, first_buffer
   117 00000070 [6400000000000000] 
   118 00000078 BE32000000                  mov rsi, 50
   119 0000007D E8(00000000)                call readString
   120                                  
   121                                      ; Convert ASCII to integer
   122 00000082 48BF-                       mov rdi, first_buffer
   122 00000084 [6400000000000000] 
   123 0000008C E8(00000000)                call atoi
   124                                  
   125 00000091 48890425[DD000000]          mov [first_number], rax
   125          ******************       warning: implicit DEFAULT ABS is deprecated [-w+implicit-abs-deprecated]
   126                                  
   127 00000099 48BF-                       mov rdi, double_new_line
   127 0000009B [A800000000000000] 
   128 000000A3 E8(00000000)                call printString
   129                                  
   130                                      ; Read the second integer
   131 000000A8 48BF-                       mov rdi, second_prompt
   131 000000AA [4A00000000000000] 
   132 000000B2 E8(00000000)                call printString
   133                                  
   134 000000B7 48BF-                       mov rdi, second_buffer
   134 000000B9 [9600000000000000] 
   135 000000C1 BE32000000                  mov rsi, 50
   136 000000C6 E8(00000000)                call readString
   137                                  
   138                                      ; Convert ASCII to integer
   139 000000CB 48BF-                       mov rdi, second_buffer
   139 000000CD [9600000000000000] 
   140 000000D5 E8(00000000)                call atoi
   141                                  
   142 000000DA 48890425[E5000000]          mov [second_number], rax
   143                                  
   144 000000E2 48BF-                       mov rdi, double_new_line
   144 000000E4 [A800000000000000] 
   145 000000EC E8(00000000)                call printString
   146                                  
   147                                      ; Multiply the two integers
   148 000000F1 488B0425[DD000000]          mov rax, [first_number]
   149 000000F9 488B1C25[E5000000]          mov rbx, [second_number]
   150                                  
   151 00000101 480FAFC3                    imul rax, rbx
   152                                  
   153 00000105 48890425[ED000000]          mov [product], rax
   154                                  
   155                                      ; Convert product into ASCII
   156 0000010D 488B3C25[ED000000]          mov rdi, [product]
   157 00000115 48BE-                       mov rsi, product_buffer
   157 00000117 [C800000000000000] 
   158 0000011F E8(00000000)                call itoa
   159                                  
   160                                      ; Save the returned string address
   161 00000124 4989C4                      mov r12, rax
   162                                  
   163                                      ; Display the product
   164 00000127 48BF-                       mov rdi, product_message
   164 00000129 [6C00000000000000] 
   165 00000131 E8(00000000)                call printString
   166                                  
   167 00000136 4C89E7                      mov rdi, r12
   168 00000139 E8(00000000)                call printString
   169                                  
   170 0000013E 48BF-                       mov rdi, double_new_line
   170 00000140 [A800000000000000] 
   171 00000148 E8(00000000)                call printString
   172                                  
   173                                      ; Farewell message
   174 0000014D 48BF-                       mov rdi, farewell_message
   174 0000014F [9200000000000000] 
   175 00000157 E8(00000000)                call printString
   176                                  
   177 0000015C 48BF-                       mov rdi, name_buffer
   177 0000015E [0000000000000000] 
   178 00000166 E8(00000000)                call printString
   179                                  
   180 0000016B 48BF-                       mov rdi, new_line
   180 0000016D [A600000000000000] 
   181 00000175 E8(00000000)                call printString
   182                                  
   183                                      ; Exit program
   184 0000017A B83C000000                  mov rax, sys_exit
   185 0000017F BF00000000                  mov rdi, exit_success
   186 00000184 0F05                        syscall
