    23                                  ; Program Information:
    24                                  ; Name: Assignment 5 - Kernel Functions
    25                                  ; Languages: x86-64 Assembly
    26                                  ; Start Date: November 17, 2026
    27                                  ; Completion Date: November 17, 2026
    28                                  ;
    29                                  ; Program's Purpose:
    30                                  ; This file provides input and output functions using Linux
    31                                  ; kernel system calls. The printString function displays
    32                                  ; null-terminated strings using syscall 1 (write). The
    33                                  ; readString function reads characters from standard input
    34                                  ; using syscall 0 (read), stores them in a buffer, and
    35                                  ; null-terminates the resulting string.
    36                                  ;
    37                                  ; Project Information:
    38                                  ; Files: main.asm, kernel.asm, atoi.asm, itoa.asm, r.sh
    39                                  ; Developing Computer: Windows 11, Ubuntu via WSL
    40                                  ; Status: Completed and tested
    41                                  ; Source: Adapted from supplemental pure_assembly.asm
    42                                  ;         example provided by Dianella Sy.
    43                                  ;
    44                                  ; Translator Information:
    45                                  ; Assembler: NASM, elf64
    46                                  ; Linker: GNU ld
    47                                  ; Operating System: Ubuntu via WSL
    48                                  
    49                                  
    50                                  global printString
    51                                  global readString
    52                                  
    53                                  section .data
    54                                      null       equ 0
    55                                      line_feed  equ 10
    56                                      stdin      equ 0
    57                                      stdout     equ 1
    58                                      sys_read   equ 0
    59                                      sys_write  equ 1
    60                                  
    61                                  section .bss
    62 00000000 ??                          character resb 1
    63                                  
    64                                  section .text
    65                                  
    66                                  ; printString
    67                                  ; Input:  rdi = address of null-terminated string
    68                                  ; Output: nothing
    69                                  printString:
    70 00000000 53                          push rbx
    71                                  
    72 00000001 4889FB                      mov rbx, rdi
    73 00000004 4831D2                      xor rdx, rdx
    74                                  
    75                                  string_count_loop:
    76 00000007 803B00                      cmp byte [rbx], null
    77 0000000A 7408                        je string_count_done
    78                                  
    79 0000000C 48FFC2                      inc rdx
    80 0000000F 48FFC3                      inc rbx
    81 00000012 EBF3                        jmp string_count_loop
    82                                  
    83                                  string_count_done:
    84 00000014 4883FA00                    cmp rdx, 0
    85 00000018 740F                        je print_done
    86                                  
    87 0000001A B801000000                  mov rax, sys_write
    88 0000001F 4889FE                      mov rsi, rdi
    89 00000022 BF01000000                  mov rdi, stdout
    90 00000027 0F05                        syscall
    91                                  
    92                                  print_done:
    93 00000029 5B                          pop rbx
    94 0000002A C3                          ret
    95                                  
    96                                  
    97                                  ; readString
    98                                  ; Input:  rdi = address of destination buffer
    99                                  ;         rsi = buffer capacity in bytes
   100                                  ; Output: rax = number of characters stored
   101                                  ; Notes:  Reserves one byte for the null terminator.
   102                                  ;         Discards excess input until newline.
   103                                  readString:
   104 0000002B 53                          push rbx
   105 0000002C 4154                        push r12
   106 0000002E 4155                        push r13
   107                                  
   108 00000030 4889FB                      mov rbx, rdi
   109 00000033 4989F5                      mov r13, rsi
   110 00000036 4D31E4                      xor r12, r12
   111                                  
   112                                  read_character:
   113 00000039 B800000000                  mov rax, sys_read
   114 0000003E BF00000000                  mov rdi, stdin
   115 00000043 488D35(00000000)            lea rsi, [rel character]
   116 0000004A BA01000000                  mov rdx, 1
   117 0000004F 0F05                        syscall
   118                                  
   119                                      ; Stop on EOF or a read error.
   120 00000051 4883F801                    cmp rax, 1
   121 00000055 751F                        jne read_done
   122                                  
   123 00000057 8A0425[00000000]            mov al, [character]
   123          ******************       warning: implicit DEFAULT ABS is deprecated [-w+implicit-abs-deprecated]
   124                                  
   125 0000005E 3C0A                        cmp al, line_feed
   126 00000060 7414                        je read_done
   127                                  
   128                                      ; Check whether there is room for this character.
   129 00000062 4C89EA                      mov rdx, r13
   130 00000065 48FFCA                      dec rdx
   131 00000068 4939D4                      cmp r12, rdx
   132 0000006B 73CC                        jae read_character
   133                                  
   134 0000006D 42880423                    mov [rbx + r12], al
   135 00000071 49FFC4                      inc r12
   136 00000074 EBC3                        jmp read_character
   137                                  
   138                                  read_done:
   139 00000076 42C6042300                  mov byte [rbx + r12], null
   140 0000007B 4C89E0                      mov rax, r12
   141                                  
   142 0000007E 415D                        pop r13
   143 00000080 415C                        pop r12
   144 00000082 5B                          pop rbx
   145 00000083 C3                          ret
